# Local: npm run admin:setup creates a hashed admin account in .env.local.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Vercel: a remote Turso libSQL database is required. Never set a file: URL here.
# Local: leave both empty to keep using ./data/onefix.sqlite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SQLITE_PATH=./data/onefix.sqlite

# AI keys stay on the server. mock works without API credits.
DEDUP_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=8000

# Optional canonical site URL for QR links. Leave empty to use the current host.
APP_BASE_URL=
FEATURE_PHOTOS=true
FEATURE_PREDICTIONS=true
# Used only for reading legacy local photos. New photos are stored in the database.
UPLOAD_DIR=./data/uploads

# Optional: add workshop examples once; existing data is preserved.
SEED_DEMO_DATA=false
